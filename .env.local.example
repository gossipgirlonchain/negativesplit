# ---------------------------------------------------------------
# Negative Split
# Copy to .env.local and fill in. Nothing here is optional in
# production; locally you can run without KV and every position
# will read as available.
# ---------------------------------------------------------------

# Stripe > Developers > API keys.
# sk_test_... while you are rehearsing, sk_live_... when you are real.
# scripts/stripe-setup.mjs reads this same variable from your shell.
STRIPE_SECRET_KEY=sk_test_

# Stripe webhook signing secret.
# Local:  run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#         and copy the whsec_... it prints on startup.
# Live:   Stripe > Developers > Webhooks > your endpoint > Signing secret.
# These are two different secrets. The live one will not verify local events.
STRIPE_WEBHOOK_SECRET=whsec_

# Vercel > your project > Storage > KV. "Connect" writes these into the
# project for you; `vercel env pull .env.local` brings them down here.
# Holds sold state and the visitor counter. No KV, no sold state.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Where this site lives. Used for canonical URLs and Open Graph.
# http://localhost:3000 locally, https://negativesplit.space in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
